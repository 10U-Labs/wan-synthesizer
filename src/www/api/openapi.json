{
  "openapi": "3.0.1",
  "info": {
    "title": "wan-synthesizer",
    "description": "Graphs as REST resources: carriers, providers and the carrier merge. Inputs are writable; computed graphs are read-only. One JSON format throughout.",
    "version": "1.0.0"
  },
  "paths": {
    "/wan-synthesizer/carriers": {
      "get": {
        "summary": "List carriers.",
        "responses": { "200": { "description": "The carriers." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/carriers/{carrier}/pops": {
      "get": {
        "summary": "A carrier's PoPs.",
        "parameters": [
          { "name": "carrier", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The carrier's PoPs." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "put": {
        "summary": "Replace a carrier's PoPs (stores only).",
        "parameters": [
          { "name": "carrier", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The carrier's PoPs were replaced." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/carriers/{carrier}/fiber-segments": {
      "get": {
        "summary": "A carrier's fiber.",
        "parameters": [
          { "name": "carrier", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The carrier's links." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "put": {
        "summary": "Replace a carrier's fiber (stores only).",
        "parameters": [
          { "name": "carrier", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The carrier's links were replaced." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/carriers/{carrier}": {
      "delete": {
        "summary": "Remove a carrier.",
        "parameters": [
          { "name": "carrier", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "The carrier was removed." } },
        "x-amazon-apigateway-integration": {
          "uri": "${CarriersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/store/prune": {
      "get": {
        "summary": "The objects stored under a name the product no longer writes.",
        "responses": { "200": { "description": "The stale keys, deleting nothing." } },
        "x-amazon-apigateway-integration": {
          "uri": "${PruneHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "post": {
        "summary": "Delete every object stored under a name the product no longer writes.",
        "requestBody": {
          "description": "The keys the caller wrote this run, which are kept whatever this deployment writes, so a seed never loses to the deploy of the name it just wrote.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "written": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "The keys that went." } },
        "x-amazon-apigateway-integration": {
          "uri": "${PruneHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/carriers/merge": {
      "post": {
        "summary": "Merge all carriers onto one map (fast).",
        "responses": { "200": { "description": "The merged carriers." } },
        "x-amazon-apigateway-integration": {
          "uri": "${MergeHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "options": {
        "summary": "CORS preflight.",
        "security": [],
        "responses": {
          "200": {
            "description": "CORS.",
            "headers": {
              "Access-Control-Allow-Origin": { "schema": { "type": "string" } },
              "Access-Control-Allow-Methods": { "schema": { "type": "string" } },
              "Access-Control-Allow-Headers": { "schema": { "type": "string" } }
            }
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "mock",
          "requestTemplates": { "application/json": "{\"statusCode\": 200}" },
          "responses": {
            "default": {
              "statusCode": "200",
              "responseParameters": {
                "method.response.header.Access-Control-Allow-Origin": "'https://www.10ulabs.com'",
                "method.response.header.Access-Control-Allow-Methods": "'GET,POST,OPTIONS'",
                "method.response.header.Access-Control-Allow-Headers": "'Authorization,Content-Type'"
              }
            }
          }
        }
      }
    },
    "/wan-synthesizer/carriers/merge/pops": {
      "get": {
        "summary": "The merged carriers' PoPs.",
        "responses": { "200": { "description": "Merged carrier PoPs." } },
        "x-amazon-apigateway-integration": {
          "uri": "${MergeHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/carriers/merge/fiber-segments": {
      "get": {
        "summary": "The merged carriers' fiber segments.",
        "responses": { "200": { "description": "Merged carrier links." } },
        "x-amazon-apigateway-integration": {
          "uri": "${MergeHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    },
    "/wan-synthesizer/providers/regions": {
      "get": {
        "summary": "The provider regions.",
        "responses": { "200": { "description": "The provider regions." } },
        "x-amazon-apigateway-integration": {
          "uri": "${ProvidersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "put": {
        "summary": "Replace the provider regions (stores only).",
        "responses": { "200": { "description": "The provider regions were replaced." } },
        "x-amazon-apigateway-integration": {
          "uri": "${ProvidersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      },
      "delete": {
        "summary": "Remove the provider regions.",
        "responses": { "200": { "description": "The provider regions were removed." } },
        "x-amazon-apigateway-integration": {
          "uri": "${ProvidersHandlerArn}",
          "httpMethod": "POST",
          "type": "aws_proxy"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "A Google ID token for an authorized account on the hosted domain, or the API key the seed holds, as a bearer token.",
        "x-amazon-apigateway-authtype": "custom",
        "x-amazon-apigateway-authorizer": {
          "type": "token",
          "authorizerUri": "${AuthorizerHandlerArn}",
          "identityValidationExpression": "^Bearer .+$",
          "authorizerResultTtlInSeconds": 300
        }
      }
    }
  },
  "security": [{ "bearer": [] }],
  "x-amazon-apigateway-gateway-responses": {
    "DEFAULT_4XX": {
      "responseParameters": { "gatewayresponse.header.Access-Control-Allow-Origin": "'https://www.10ulabs.com'" }
    },
    "DEFAULT_5XX": {
      "responseParameters": { "gatewayresponse.header.Access-Control-Allow-Origin": "'https://www.10ulabs.com'" }
    }
  }
}
