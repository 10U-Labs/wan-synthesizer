{
  "openapi": "3.0.1",
  "info": {
    "title": "wan-synthesizer",
    "description": "Graphs as REST resources: carriers, providers, the carrier merge, and tenants' WANs. Inputs are writable; computed graphs are read-only. One JSON format throughout.",
    "version": "1.0.0"
  },
